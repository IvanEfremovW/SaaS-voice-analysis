PORT=8030

# Bitrix24 incoming webhook URL. The real one contains a secret: keep it only in .env (not committed).
# Local Bitrix24 mock (mocks/bitrix24):
#   - service started with npm start:   http://localhost:8024/rest/1/mock-webhook
#   - service in Docker, mock on host:  http://host.docker.internal:8024/rest/1/mock-webhook
#   - both in one docker compose:       http://bitrix24-mock:8024/rest/1/mock-webhook
BITRIX_WEBHOOK_URL=http://localhost:8024/rest/1/mock-webhook

# Where downloaded recordings are saved.
DOWNLOAD_DIR=downloads
