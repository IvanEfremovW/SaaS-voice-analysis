# Settings of data_provider. Copy to .env.
# In docker compose, the values shared with other services (port, database, S3, Bitrix24) are
# overridden from the root .env (see ../docker-compose.yml); here they matter only for `npm start`.

PORT=8030

# Bitrix24 incoming webhook URL. The real one contains a secret: keep it only in .env.
BITRIX_WEBHOOK_URL=http://localhost:8024/rest/1/mock-webhook

# Where downloaded recordings are saved.
DOWNLOAD_DIR=downloads

# Postgres and S3 of the root docker compose, as seen from the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/voice_analysis
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voice-analysis
