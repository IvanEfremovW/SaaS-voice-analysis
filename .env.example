# Settings shared by the services of docker-compose.yml. Copy to .env (not committed).
# Settings that only one service needs go into that service's own .env (e.g. data_provider/.env).

# PostgreSQL. Avoid "@", ":" and "/" in the password: it is put into a connection URL as is.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_analysis

# S3 storage (MinIO locally)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voice-analysis

# Ports published on the host machine (localhost only). 5434, because 5432 is often taken by a local PostgreSQL.
POSTGRES_HOST_PORT=5434
S3_HOST_PORT=9000
S3_CONSOLE_HOST_PORT=9001
DATA_PROVIDER_HOST_PORT=8030
