# Settings of the web service. Copy to .env (not committed).
# In docker-compose.yml PORT and DATA_PROVIDER_URL are set to the addresses inside the docker network.

PORT=8040
# Where data_provider answers
DATA_PROVIDER_URL=http://localhost:8030
# There is no login yet: the site acts as this user (they must exist in data_provider, see POST /users there).
# Their role decides whether the admin pages are shown.
CURRENT_USER_EMAIL=anna.test@example.com
