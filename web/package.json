{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "imports": {
    "#backend/*": "./backend/*",
    "#frontend/*": "./frontend/src/*"
  },
  "scripts": {
    "dev:backend": "node --env-file-if-exists=.env --watch backend/server.ts",
    "dev:frontend": "vite frontend",
    "build": "vite build frontend",
    "start": "node --env-file-if-exists=.env backend/server.ts",
    "typecheck": "tsc -p backend && tsc -p frontend",
    "test": "node --env-file=.env.example --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
